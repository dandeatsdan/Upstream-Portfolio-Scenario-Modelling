        <mxCell id="j4M3jxppPjbU7RO2-nCg-141" parent="xH5mV7unMsUPdfLFTdAY-243" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=10;align=center;verticalAlign=top;spacingTop=0;spacingLeft=0;" value="&lt;table border=&quot;1&quot; style=&quot;border: 1px solid rgb(0, 51, 0); border-collapse: collapse;&quot; cellpadding=&quot;3&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td border=&quot;1&quot; style=&quot;border-collapse: collapse; border-color: rgb(0, 51, 0);&quot;&gt;Metric&lt;/td&gt;&lt;td&gt;Avg 5 Yr&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td border=&quot;1&quot; style=&quot;border-collapse: collapse; border-color: rgb(0, 51, 0);&quot;&gt;Case&lt;/td&gt;&lt;td border=&quot;1&quot; style=&quot;border: 1px solid light-dark(rgb(0, 51, 0), rgb(174, 218, 174)); border-collapse: collapse;&quot;&gt;2026&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td border=&quot;1&quot; style=&quot;border-collapse: collapse; border: 1px solid rgb(0, 51, 0);&quot;&gt;Total 5 Yr&lt;/td&gt;&lt;td border=&quot;1&quot; style=&quot;border: 1px solid light-dark(rgb(0, 51, 0), rgb(174, 218, 174)); border-collapse: collapse;&quot;&gt;2027&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2028&lt;/td&gt;&lt;td&gt;2029&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2030&lt;/td&gt;&lt;td&gt;Index (&lt;b&gt;PK&lt;/b&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
