        <mxCell id="YbqmEhzo_ljBbs4Gu1zp-176" parent="fhdA6c5ZEEW-gf_SAT2R-90" style="whiteSpace=wrap;html=1;fontSize=13;align=left;spacing=5;spacingLeft=5;spacingRight=5;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" value="&lt;div&gt;&lt;b&gt;System Data&lt;/b&gt;&lt;/div&gt;Financial profiles are purpose-limited from the Azure data estate, while dimensional and hierarchy data is sourced from ADH / Databricks." vertex="1">
