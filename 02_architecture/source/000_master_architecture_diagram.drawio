        <mxCell id="fhdA6c5ZEEW-gf_SAT2R-108" connectable="0" parent="YbqmEhzo_ljBbs4Gu1zp-173" style="group" value="" vertex="1">
          <mxGeometry height="153" width="954.59" x="11.710000000000036" y="998.97" as="geometry" />
        </mxCell>
        <mxCell id="fhdA6c5ZEEW-gf_SAT2R-109" parent="fhdA6c5ZEEW-gf_SAT2R-108" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;rounded=0;fontSize=13;spacing=10;fontFamily=Helvetica;spacingBottom=0;fontColor=default;fontStyle=0;" value="&lt;ul style=&quot;padding-left: 10px;&quot;&gt;&lt;li data-section-id=&quot;13gqmb9&quot; data-start=&quot;793&quot; data-end=&quot;901&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Purpose limitation:&lt;/b&gt; only data required for scenario modelling is selected&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;13gqmb9&quot; data-start=&quot;793&quot; data-end=&quot;901&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Data minimisation: &lt;/b&gt;unnecessary accounts and transactions are excluded upstream&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;13gqmb9&quot; data-start=&quot;793&quot; data-end=&quot;901&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Controlled scope: &lt;/b&gt;defined account mappings determine the modelling dataset&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;13gqmb9&quot; data-start=&quot;793&quot; data-end=&quot;901&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Transparent derivation: &lt;/b&gt;calculated metrics are built from explicit, inspectable rules&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="76" width="477.29" y="30" as="geometry" />
        </mxCell>
        <mxCell id="fhdA6c5ZEEW-gf_SAT2R-110" parent="fhdA6c5ZEEW-gf_SAT2R-108" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;rounded=0;fontSize=13;spacing=10;fontFamily=Helvetica;fontColor=default;fontStyle=0;spacingBottom=0;" value="&lt;ul style=&quot;padding-left: 10px; margin-top: 12px; margin-bottom: 12px; margin-left: 0px;&quot;&gt;&lt;li data-section-id=&quot;qfg7&quot; data-start=&quot;1200&quot; data-end=&quot;1303&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Consistent calculation: &lt;/b&gt;common logic is applied systematically across the dataset&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;qfg7&quot; data-start=&quot;1200&quot; data-end=&quot;1303&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Source traceability: &lt;/b&gt;calculated outputs remain attributable to underlying source metrics&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;qfg7&quot; data-start=&quot;1200&quot; data-end=&quot;1303&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Early transformation: &lt;/b&gt;calculations are performed upstream&amp;nbsp; to simplify processing&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;qfg7&quot; data-start=&quot;1200&quot; data-end=&quot;1303&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Reusable logic: &lt;/b&gt;standard calculation rules support consistent use across scenarios&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="76" width="477.29" x="477.29" y="30" as="geometry" />
        </mxCell>
        <mxCell id="fhdA6c5ZEEW-gf_SAT2R-111" parent="fhdA6c5ZEEW-gf_SAT2R-108" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;rounded=0;fontSize=15;spacing=10;fontFamily=Helvetica;" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Design Principles&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="954.59" as="geometry" />
        </mxCell>
        <mxCell id="xH5mV7unMsUPdfLFTdAY-2" parent="xH5mV7unMsUPdfLFTdAY-4" style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;rounded=0;fontSize=18;spacing=0;fontColor=#333333;glass=0;shadow=0;shapeInsidePadding=4;spacingTop=5;spacingLeft=5;spacingBottom=5;spacingRight=5;" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;How it Works&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;strong data-start=&quot;145&quot; data-end=&quot;174&quot; style=&quot;background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193)); font-size: 12px;&quot;&gt;Route 1 — Direct Accounts&lt;/strong&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;Required lowest-level Account Planning Keys are defined in the controlled schedule and used as the driving table for the transaction join. This limits the resulting dataset to only the financial profiles required by the modeller.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong data-start=&quot;408&quot; data-end=&quot;440&quot; style=&quot;font-size: 12px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;Route 2 — Calculated Members&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;Calculated members are mapped to their underlying Account Planning Keys in the same controlled schedule. Transactions are joined to these mappings, then aggregated back to the parent member to derive metrics such as Gross Margin.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong data-start=&quot;674&quot; data-end=&quot;694&quot; style=&quot;font-size: 12px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;Why this matters&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;Account scope and calculation definitions remain outside the transformation code. Users can extend the controlled schedules without changing the underlying Power Query logic.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="288.47" width="485" x="257.5" y="694.5" as="geometry" />
        </mxCell>
        <mxCell id="xH5mV7unMsUPdfLFTdAY-5" edge="1" parent="xH5mV7unMsUPdfLFTdAY-4" source="xH5mV7unMsUPdfLFTdAY-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;innerLoopWaypoints=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="xH5mV7unMsUPdfLFTdAY-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b_-dq4IY0zQRH7gopXyB-1" connectable="0" parent="udcwdMiNgaylk7ucZYJF-1" style="group;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="1233" width="860" x="2270" y="112" as="geometry" />
        </mxCell>
        <mxCell id="xH5mV7unMsUPdfLFTdAY-120" parent="b_-dq4IY0zQRH7gopXyB-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=20;align=left;spacing=10;verticalAlign=top;fontStyle=1" value="&lt;div&gt;Controlled Financial Entity to Modelling Case Translation&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px; font-weight: normal;&quot;&gt;The Financial Entity to Modelling Case translation decouples source-system grain from modelling grain, allowing the semantic model to retain detailed Financial Entity data while the Scenario Modeller operates on a user-defined case-level structure.&lt;/font&gt;&lt;/div&gt; " vertex="1">
          <mxGeometry height="1194.5" width="860" as="geometry" />
