        </mxCell>
        <mxCell id="xH5mV7unMsUPdfLFTdAY-294" parent="fhdA6c5ZEEW-gf_SAT2R-117" style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;rounded=0;fontSize=13;spacing=10;fontColor=default;glass=0;shadow=0;spacingTop=10;spacingRight=10;fontFamily=Helvetica;fontStyle=0;spacingBottom=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;How it Works&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 5px;&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span&gt;&lt;b&gt;Four DAX-based OLE DB queries&lt;/b&gt; expose controlled semantic-model outputs to the Excel scenario modeller.&amp;nbsp;&lt;/span&gt;The resulting Excel tables form a stable interface between the semantic model, user-facing configuration sheets, and Python modules.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Case listing&lt;/b&gt;, &lt;b style=&quot;&quot;&gt;profiles&lt;/b&gt; and &lt;b style=&quot;&quot;&gt;tax&lt;/b&gt; datasets are &lt;b style=&quot;&quot;&gt;loaded into Python&lt;/b&gt; for validation and scenario processing, while the summarised &lt;b style=&quot;&quot;&gt;Totals &amp;amp; Avgs&lt;/b&gt; dataset remains an &lt;b style=&quot;&quot;&gt;Excel-only decision-support layer&lt;/b&gt;.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="105.76577515039453" width="820" x="18" y="864.2722900769984" as="geometry" />
        </mxCell>
        <mxCell id="fhdA6c5ZEEW-gf_SAT2R-113" connectable="0" parent="fhdA6c5ZEEW-gf_SAT2R-117" style="group" value="" vertex="1">
          <mxGeometry height="176.27629191732422" width="820" x="18" y="995.4425896507721" as="geometry" />
        </mxCell>
        <mxCell id="fhdA6c5ZEEW-gf_SAT2R-114" parent="fhdA6c5ZEEW-gf_SAT2R-113" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;rounded=0;fontSize=13;spacing=10;fontFamily=Helvetica;spacingBottom=0;fontColor=default;fontStyle=0;" value="&lt;ul style=&quot;padding-left: 10px;&quot;&gt;&lt;li data-section-id=&quot;13gqmb9&quot; data-start=&quot;793&quot; data-end=&quot;901&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Governed access: &lt;/b&gt;Excel consumes controlled semantic-model outputs rather than accessing source data directly&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;13gqmb9&quot; data-start=&quot;793&quot; data-end=&quot;901&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Purpose-specific extraction: &lt;/b&gt;queries return only the data required by each modelling function&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;13gqmb9&quot; data-start=&quot;793&quot; data-end=&quot;901&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Single source of truth: &lt;/b&gt;common semantic-model logic supports consistent downstream analysis&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;13gqmb9&quot; data-start=&quot;793&quot; data-end=&quot;901&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Separation of concerns: &lt;/b&gt;data retrieval remains distinct from scenario configuration and calculation&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="145.1687109907376" width="410" y="31.10758092658663" as="geometry" />
        </mxCell>
        <mxCell id="fhdA6c5ZEEW-gf_SAT2R-115" parent="fhdA6c5ZEEW-gf_SAT2R-113" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;rounded=0;fontSize=13;spacing=10;fontFamily=Helvetica;fontColor=default;fontStyle=0;spacingBottom=0;" value="&lt;ul style=&quot;padding-left: 10px; margin-top: 12px; margin-bottom: 12px; margin-left: 0px;&quot;&gt;&lt;li data-section-id=&quot;qfg7&quot; data-start=&quot;1200&quot; data-end=&quot;1303&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Transparent interfaces: &lt;/b&gt;defined queries make data movement and transformation inspectable&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;qfg7&quot; data-start=&quot;1200&quot; data-end=&quot;1303&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Consistent structures: &lt;/b&gt;standardised outputs provide predictable inputs to Excel and Python&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;qfg7&quot; data-start=&quot;1200&quot; data-end=&quot;1303&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Data minimisation: &lt;/b&gt;only required attributes, metrics and periods are transferred&lt;/span&gt;&lt;/li&gt;&lt;li data-section-id=&quot;qfg7&quot; data-start=&quot;1200&quot; data-end=&quot;1303&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Reusable integration: &lt;/b&gt;common interface patterns support maintainable downstream datasets&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="145.1687109907376" width="410" x="410" y="31.10758092658663" as="geometry" />
        </mxCell>
