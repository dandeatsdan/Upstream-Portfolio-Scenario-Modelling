        <mxCell id="YbqmEhzo_ljBbs4Gu1zp-2" parent="fhdA6c5ZEEW-gf_SAT2R-80" style="whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=40;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;Financial data profiles and dimensional hierarchies are sourced through the Azure data estate and combined with controlled SharePoint inputs within the Power BI semantic model.&lt;/span&gt;" vertex="1">
