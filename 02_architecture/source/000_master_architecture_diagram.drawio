        </mxCell>
        <mxCell id="YbqmEhzo_ljBbs4Gu1zp-179" parent="fhdA6c5ZEEW-gf_SAT2R-90" style="whiteSpace=wrap;html=1;fontSize=13;align=left;spacing=5;spacingLeft=5;spacingRight=5;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;" value="&lt;div&gt;&lt;b&gt;Standardised Integration&lt;/b&gt;&lt;/div&gt;Power Query applies reusable transformation, mapping and validation logic to combine system and controlled inputs within the semantic model." vertex="1">
