        <mxCell id="j4M3jxppPjbU7RO2-nCg-146" parent="xH5mV7unMsUPdfLFTdAY-243" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=8;" value="&lt;b&gt;Human readable &lt;/b&gt;(left-to-right)&amp;nbsp;version of financial profiles to support user decisions" vertex="1">
