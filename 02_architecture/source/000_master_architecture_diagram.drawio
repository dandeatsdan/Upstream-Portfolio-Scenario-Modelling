        <mxCell id="YbqmEhzo_ljBbs4Gu1zp-3" parent="fhdA6c5ZEEW-gf_SAT2R-80" style="whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=40;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;Selected data is extracted into the Excel scenario modeller, where user-defined scenario configurations are executed through the Python engine.&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="309.13" x="930.44" y="801.5" as="geometry" />
