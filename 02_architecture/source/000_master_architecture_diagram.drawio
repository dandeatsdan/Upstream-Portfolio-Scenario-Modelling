        <mxCell id="YbqmEhzo_ljBbs4Gu1zp-178" parent="fhdA6c5ZEEW-gf_SAT2R-90" style="whiteSpace=wrap;html=1;fontSize=13;align=left;spacing=5;spacingLeft=5;spacingRight=5;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" value="&lt;div&gt;&lt;b&gt;Controlled Business Inputs&lt;/b&gt;&lt;/div&gt;SharePoint-hosted Excel schedules provide account aggregation logic, tax assumptions, manual financial profiles and Financial Entity-to-case mappings." vertex="1">
