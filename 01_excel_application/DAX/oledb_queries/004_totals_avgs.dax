## This code block defines a DAX query that retrieves and processes financial data from a Power BI semantic model using OLE DB connections.
## The query filters the data to include only financial entities related to Oil or Gas, aggregates key figures by year, metric, and case, and limits the result set to 500,000 rows with deterministic ordering.
## The output includes columns for Year, Metric, Metric Sort, Case, and the aggregated Value
## Note the connection string has been specifically excluded from this file for security reasons, and the query is intended to be executed within the context of a secure Power BI environment where the user has appropriate access permissions.
## Downstream this query is referenced in the scenario configuration input sheets to support decisions on case inclusion and operation selection.


DEFINE
    // Base measure for Common_Key_Figure
    MEASURE 'TRANS_FIN_ADL'[Total Common_Key_Figure] =
        SUM('TRANS_FIN_ADL'[Common_Key_Figure])

    // Restrict to calendar years 2026–2030 (respecting any external slicer on Calendar_Year)
    VAR __DS0YearFilter =
        FILTER(
            KEEPFILTERS(
                VALUES('TRANS_FIN_ADL'[Calendar_Year])
            ),
            'TRANS_FIN_ADL'[Calendar_Year] >= "2026"
                && 'TRANS_FIN_ADL'[Calendar_Year] <= "2030"
        )

    // Filter Financial Entities to BP Group Entities = Oil or Gas
    VAR __DS0EntityFilter =
        FILTER(
            KEEPFILTERS(
                VALUES('Dim_Financial_Entity_ADL'[BP_Group_Entities_Text])
            ),
            'Dim_Financial_Entity_ADL'[BP_Group_Entities_Text] = "Oil"
                || 'Dim_Financial_Entity_ADL'[BP_Group_Entities_Text] = "Gas"
        )

    // Core dataset: Metric, Case, 5-year values, and explicit annual sums for 2026–2030
    VAR __DS0Core =
        SELECTCOLUMNS(
            SUMMARIZECOLUMNS(
                'ACCOUNTS_SORTING'[Description],
                'TRANS_FIN_ADL'[Modelling_Case],

                __DS0YearFilter,      // limit to 2026–2030
                __DS0EntityFilter,    // limit to Oil / Gas entities

                // 5-year cumulative total (sum of 2026–2030)
                "Total5Y", [Total Common_Key_Figure],

                // Explicit annual totals for each year 2026–2030
                "Y2026",
                    CALCULATE(
                        [Total Common_Key_Figure],
                        'TRANS_FIN_ADL'[Calendar_Year] = "2026"
                    ),
                "Y2027",
                    CALCULATE(
                        [Total Common_Key_Figure],
                        'TRANS_FIN_ADL'[Calendar_Year] = "2027"
                    ),
                "Y2028",
                    CALCULATE(
                        [Total Common_Key_Figure],
                        'TRANS_FIN_ADL'[Calendar_Year] = "2028"
                    ),
                "Y2029",
                    CALCULATE(
                        [Total Common_Key_Figure],
                        'TRANS_FIN_ADL'[Calendar_Year] = "2029"
                    ),
                "Y2030",
                    CALCULATE(
                        [Total Common_Key_Figure],
                        'TRANS_FIN_ADL'[Calendar_Year] = "2030"
                    )
            ),

            "Metric",
                'ACCOUNTS_SORTING'[Description],

            "Case",
                'TRANS_FIN_ADL'[Modelling_Case],

            // 5-year cumulative total
            "Total 5Y",
                [Total5Y],

            // 5-year average per year (2026–2030)
            "Average 5Y",
                DIVIDE([Total5Y], 5),

            // Per-year sums, explicitly named by calendar year
            "2026",
                [Y2026],
            "2027",
                [Y2027],
            "2028",
                [Y2028],
            "2029",
                [Y2029],
            "2030",
                [Y2030]
        )

    // Limit result set to 500,000 rows with deterministic ordering
    VAR __DS0BodyLimited =
        TOPN(
            500000,
            __DS0Core,
            [Metric], 1,
            [Case], 1
        )

EVALUATE
    __DS0BodyLimited

ORDER BY
    [Metric],
    [Case]