## This code block defines a DAX query that retrieves a distinct listing of cases along with their associated metadata, filtered to include only entities belonging to the Oil and Gas group. The query summarizes the data by case, group entity, segment, region, and country, and limits the output to the first 500,000 rows in a deterministic order.
## It also extracts and formats the plan type and case name from the Modelling_Case field for better readability in the final output.
## The results are ordered by group entity, segment, region, country, and case for easy navigation and analysis.
## the query is designed to be used in an Excel application that connects to a Power BI semantic model via OLE DB, allowing users to retrieve and analyze case listings efficiently.
## Note the connection string has been specifically excluded from this file for security reasons, and the query is intended to be executed within the context of a secure Power BI environment where the user has appropriate access permissions.
## Downstream this query supports the model engine where reference data is rejoined with the scenario results to produce a output table suitable for slice-and-dice reporting. 


DEFINE
    // Filter to only include Oil and Gas group entities
    VAR _EntityFilter =
        TREATAS(
            {
                "Oil",
                "Gas"
            },
            'Dim_Financial_Entity_ADL'[BP_Group_Entities_Text]
        )

    // Distinct combinations of case, group entity, segment, region, country key and country text
    // for Oil/Gas group entities
    VAR __DS0Core =
        CALCULATETABLE(
            SUMMARIZE(
                'TRANS_FIN_ADL',
                'TRANS_FIN_ADL'[Modelling_Case],
                'Dim_Financial_Entity_ADL'[BP_Group_Entities_Text],
                'Dim_Financial_Entity_ADL'[Segment_Text],
                'Dim_Financial_Entity_ADL'[Region_Text],
                'Dim_Financial_Entity_ADL'[Country],       // Country key
                'Dim_Financial_Entity_ADL'[Country_Text]   // Country description
            ),
            _EntityFilter
        )

    // Limit to first 500,000 rows in a deterministic order
    // Sort order matches final ORDER BY with Case last
    VAR __DS0BodyLimited =
        TOPN(
            500000,
            __DS0Core,
            'Dim_Financial_Entity_ADL'[BP_Group_Entities_Text], ASC,
            'Dim_Financial_Entity_ADL'[Segment_Text], ASC,
            'Dim_Financial_Entity_ADL'[Region_Text], ASC,
            'Dim_Financial_Entity_ADL'[Country_Text], ASC,
            'TRANS_FIN_ADL'[Modelling_Case], ASC
        )

EVALUATE
    // Project and rename columns for final output
    // Add [Plan Type] = TRIM(text after last "|")
    // and [Case Name] = text before last "|"
    SELECTCOLUMNS(
        __DS0BodyLimited,
        "Case", 'TRANS_FIN_ADL'[Modelling_Case],
        "Plan Type",
            VAR _Case = 'TRANS_FIN_ADL'[Modelling_Case]
            // Count how many "|" characters there are
            VAR _PipeCount =
                LEN(_Case) - LEN(SUBSTITUTE(_Case, "|", ""))
            // Position of the last "|" using SUBSTITUTE trick
            VAR _LastPipePos =
                IF(
                    _PipeCount > 0,
                    FIND(
                        "@",
                        SUBSTITUTE(_Case, "|", "@", _PipeCount),
                        1
                    )
                )
            RETURN
                IF(
                    _PipeCount > 0,
                    TRIM(
                        MID(
                            _Case,
                            _LastPipePos + 1,
                            LEN(_Case) - _LastPipePos
                        )
                    ),
                    BLANK()
                ),
        "Case Name",
            VAR _Case2 = 'TRANS_FIN_ADL'[Modelling_Case]
            VAR _PipeCount2 =
                LEN(_Case2) - LEN(SUBSTITUTE(_Case2, "|", ""))
            VAR _LastPipePos2 =
                IF(
                    _PipeCount2 > 0,
                    FIND(
                        "@",
                        SUBSTITUTE(_Case2, "|", "@", _PipeCount2),
                        1
                    )
                )
            RETURN
                IF(
                    _PipeCount2 > 0,
                    LEFT(_Case2, _LastPipePos2 - 1),
                    _Case2
                ),
        "Group Entity", 'Dim_Financial_Entity_ADL'[BP_Group_Entities_Text],
        "Segment", 'Dim_Financial_Entity_ADL'[Segment_Text],
        "Region", 'Dim_Financial_Entity_ADL'[Region_Text],
        "Country Key", 'Dim_Financial_Entity_ADL'[Country],          // Added country key
        "Country", 'Dim_Financial_Entity_ADL'[Country_Text]
    )

ORDER BY
    [Group Entity] ASC,
    [Segment] ASC,
    [Region] ASC,
    [Country] ASC,
    [Case] ASC